import { useEffect, useRef, useState } from "react";
import "./App.css";

/*
  Estados visuais do Jarvis.

  standby    = parado / aguardando
  listening  = ouvindo
  processing = processando comando
  speaking   = falando resposta
*/
type AssistantState = "standby" | "listening" | "processing" | "speaking";

/*
  Tipagem manual da API de reconhecimento de voz do navegador.

  O Tauri usa uma WebView por baixo.
  Em alguns ambientes, o TypeScript não reconhece SpeechRecognition automaticamente,
  então declaramos os tipos básicos aqui para evitar erro.
*/
type SpeechRecognitionConstructor = new () => SpeechRecognition;

interface SpeechRecognition extends EventTarget {
  lang: string;
  continuous: boolean;
  interimResults: boolean;
  maxAlternatives: number;
  start: () => void;
  stop: () => void;
  abort: () => void;
  onstart: (() => void) | null;
  onend: (() => void) | null;
  onerror: ((event: SpeechRecognitionErrorEvent) => void) | null;
  onresult: ((event: SpeechRecognitionEvent) => void) | null;
}

interface SpeechRecognitionErrorEvent extends Event {
  error: string;
  message: string;
}

interface SpeechRecognitionEvent extends Event {
  resultIndex: number;
  results: SpeechRecognitionResultList;
}

declare global {
  interface Window {
    SpeechRecognition?: SpeechRecognitionConstructor;
    webkitSpeechRecognition?: SpeechRecognitionConstructor;
  }
}

function App() {
  /*
    Estado visual atual do córtex.
    Esse estado controla as animações no CSS.
  */
  const [state, setState] = useState<AssistantState>("standby");

  /*
    Indica se o Jarvis foi chamado e está aguardando um comando.
    Exemplo:
    Você fala: "Ei, Jarvis"
    Ele responde: "Estou na escuta, Mestre"
    Durante alguns segundos, isAwake fica true.
  */
  const [isAwake, setIsAwake] = useState(false);

  /*
    Referência da instância atual de reconhecimento de voz.
    Usamos ref para conseguir iniciar/parar sem depender de renderização.
  */
  const recognitionRef = useRef<SpeechRecognition | null>(null);

  /*
    Controla se o Jarvis deve continuar ouvindo continuamente.
    Se for false, ele para a escuta.
  */
  const shouldKeepListeningRef = useRef(true);

  /*
    Evita que o Jarvis tente ouvir enquanto ele mesmo está falando.
    Se ele ouvisse a própria voz, entraria num teatro ridículo de máquina falando com máquina.
  */
  const isSpeakingRef = useRef(false);

  /*
    Versão em ref do isAwake.
    Usamos porque callbacks de voz podem ficar com estado antigo.
  */
  const isAwakeRef = useRef(false);

  /*
    Timers usados para reiniciar escuta e encerrar modo de comando.
  */
  const restartTimeoutRef = useRef<number | null>(null);
  const commandTimeoutRef = useRef<number | null>(null);

  /*
    Atualiza o estado visual do assistente.
  */
  function setAssistantState(nextState: AssistantState) {
    setState(nextState);
  }

  /*
    Normaliza texto reconhecido pela voz.

    Exemplo:
    "Ei, Járvis!" vira "ei jarvis"

    Isso ajuda porque o reconhecimento de voz adora inventar moda.
  */
  function normalizeText(text: string) {
    return text
      .toLowerCase()
      .normalize("NFD")
      .replace(/[\u0300-\u036f]/g, "")
      .replace(/[.,!?;:]/g, " ")
      .replace(/\s+/g, " ")
      .trim();
  }

  /*
    Verifica se a frase captada contém a palavra de ativação.

    Aceitamos variações porque o reconhecimento pode entender Jarvis como:
    - Jervis
    - Jarves
    - Javis
    - Jarvi

    Tecnologia moderna, aparentemente.
  */
  function containsWakeWord(text: string) {
    const normalizedText = normalizeText(text);

    const wakeVariants = [
      "ei jarvis",
      "e jarvis",
      "hey jarvis",
      "oi jarvis",
      "alo jarvis",
      "alô jarvis",
      "jarvis",
      "jervis",
      "jarves",
      "jarvez",
      "jarvi",
      "javis",
      "javes",
      "jarvis esta na escuta",
      "jarvis está na escuta",
      "jarvis na escuta",
      "jarvis voce esta ai",
      "jarvis você está aí",
    ];

    return wakeVariants.some((variant) => {
      const normalizedVariant = normalizeText(variant);

      return (
        normalizedText === normalizedVariant ||
        normalizedText.startsWith(`${normalizedVariant} `) ||
        normalizedText.includes(` ${normalizedVariant} `) ||
        normalizedText.endsWith(` ${normalizedVariant}`)
      );
    });
  }

  /*
    Remove a palavra de ativação da frase.

    Exemplo:
    "Jarvis, verifique as mensagens do WhatsApp"
    vira:
    "verifique as mensagens do whatsapp"
  */
  function removeWakeWord(text: string) {
    let cleanedText = normalizeText(text);

    const wakeVariants = [
      "ei jarvis",
      "e jarvis",
      "hey jarvis",
      "oi jarvis",
      "alo jarvis",
      "alô jarvis",
      "jarvis esta na escuta",
      "jarvis está na escuta",
      "jarvis na escuta",
      "jarvis voce esta ai",
      "jarvis você está aí",
      "jarvis",
      "jervis",
      "jarves",
      "jarvez",
      "jarvi",
      "javis",
      "javes",
    ];

    wakeVariants.forEach((variant) => {
      const normalizedVariant = normalizeText(variant);

      cleanedText = cleanedText
        .replace(new RegExp(`^${normalizedVariant}\\s*`, "i"), "")
        .replace(new RegExp(`\\s*${normalizedVariant}\\s*`, "i"), " ");
    });

    return cleanedText.replace(/\s+/g, " ").trim();
  }

  /*
    Limpa o timer que reinicia a escuta.
  */
  function clearRestartTimeout() {
    if (restartTimeoutRef.current) {
      window.clearTimeout(restartTimeoutRef.current);
      restartTimeoutRef.current = null;
    }
  }

  /*
    Limpa o timer do modo acordado.
  */
  function clearCommandTimeout() {
    if (commandTimeoutRef.current) {
      window.clearTimeout(commandTimeoutRef.current);
      commandTimeoutRef.current = null;
    }
  }

  /*
    Para a instância atual de reconhecimento de voz.
    Usamos isso antes do Jarvis falar, para ele não escutar a própria voz.
  */
  function stopRecognitionInstance() {
    const currentRecognition = recognitionRef.current;

    if (!currentRecognition) return;

    recognitionRef.current = null;
    currentRecognition.onend = null;
    currentRecognition.onerror = null;
    currentRecognition.onresult = null;

    try {
      currentRecognition.stop();
    } catch {
      try {
        currentRecognition.abort();
      } catch {
        /*
          Alguns ambientes disparam erro se a escuta já estiver parada.
          Ignoramos, porque discutir com WebView é uma humilhação técnica.
        */
      }
    }
  }

  /*
    Agenda o reinício da escuta.
    Isso acontece depois que o Jarvis termina de falar.
  */
  function scheduleRestartListening(delay = 450) {
    clearRestartTimeout();

    if (!shouldKeepListeningRef.current || isSpeakingRef.current) return;

    restartTimeoutRef.current = window.setTimeout(() => {
      startContinuousListening();
    }, delay);
  }

  /*
    Escolhe a melhor voz disponível no sistema.

    Primeiro tenta uma voz pt-BR.
    Se não tiver, tenta qualquer voz em português.
    Se não tiver, usa a primeira disponível.
  */
  function getBestVoice() {
    const synth = window.speechSynthesis;

    if (!synth) return null;

    const voices = synth.getVoices();

    if (voices.length === 0) return null;

    const brazilianVoice = voices.find((voice) =>
      voice.lang.toLowerCase().includes("pt-br")
    );

    if (brazilianVoice) return brazilianVoice;

    const portugueseVoice = voices.find((voice) =>
      voice.lang.toLowerCase().startsWith("pt")
    );

    if (portugueseVoice) return portugueseVoice;

    return voices[0];
  }

  /*
    Faz o Jarvis falar usando a voz do sistema.

    Durante a fala:
    - ele para de ouvir
    - o córtex entra no estado "speaking"
    - quando termina, a escuta contínua volta
  */
  function speak(text: string) {
    stopRecognitionInstance();

    const synth = window.speechSynthesis;

    if (!synth) {
      setAssistantState("listening");
      scheduleRestartListening(700);
      return;
    }

    synth.cancel();

    window.setTimeout(() => {
      const utterance = new SpeechSynthesisUtterance(text);
      const selectedVoice = getBestVoice();

      utterance.lang = "pt-BR";
      utterance.rate = 0.92;
      utterance.pitch = 0.85;
      utterance.volume = 1;

      if (selectedVoice) {
        utterance.voice = selectedVoice;
      }

      utterance.onstart = () => {
        isSpeakingRef.current = true;
        setAssistantState("speaking");
      };

      utterance.onend = () => {
        isSpeakingRef.current = false;

        if (shouldKeepListeningRef.current) {
          scheduleRestartListening(650);
        } else {
          setAssistantState("standby");
        }
      };

      utterance.onerror = () => {
        isSpeakingRef.current = false;

        if (shouldKeepListeningRef.current) {
          scheduleRestartListening(650);
        } else {
          setAssistantState("standby");
        }
      };

      synth.speak(utterance);
    }, 250);
  }

  /*
    Ativa o modo de comando.

    Quando você diz:
    "Ei, Jarvis"

    Ele responde:
    "Estou na escuta, Mestre."

    Depois ele fica esperando um comando por alguns segundos.
  */
  function activateWakeMode() {
    clearCommandTimeout();

    isAwakeRef.current = true;
    setIsAwake(true);

    speak("Estou na escuta, Mestre.");

    commandTimeoutRef.current = window.setTimeout(() => {
      if (!isAwakeRef.current) return;

      isAwakeRef.current = false;
      setIsAwake(false);
    }, 12000);
  }

  /*
    Encerra o modo de comando depois que uma ordem é processada.
  */
  function finishCommandMode() {
    clearCommandTimeout();

    isAwakeRef.current = false;
    setIsAwake(false);
  }

  /*
    Mensagens simuladas do WhatsApp.

    Por enquanto isso é falso de propósito.
    Essa função serve para testar o fluxo:

    voz -> comando -> interpretação -> resposta falada

    Depois vamos trocar essa lista simulada por mensagens reais vindas
    de um bridge com WhatsApp Web ou outro caminho viável.
  */
  function getSimulatedWhatsappMessages() {
    return [
      {
        sender: "Carlos",
        text: "Cheguei aqui. Você já saiu?",
        time: "18:42",
      },
      {
        sender: "Maria",
        text: "Me avisa quando puder falar.",
        time: "18:37",
      },
      {
        sender: "Grupo Família",
        text: "Alguém vai passar no mercado hoje?",
        time: "18:21",
      },
    ];
  }

  /*
    Monta um resumo falado das mensagens simuladas.
  */
  function getSimulatedWhatsappSummary() {
    const messages = getSimulatedWhatsappMessages();
    const totalMessages = messages.length;

    const messageSummary = messages
      .map((message) => {
        return `${message.sender}, às ${message.time}, disse: ${message.text}`;
      })
      .join(". ");

    return `Você tem ${totalMessages} mensagens recentes no WhatsApp. ${messageSummary}`;
  }

  /*
    Verifica se o comando tem relação com WhatsApp.

    Colocamos várias variações porque o reconhecimento de voz pode transformar
    "WhatsApp" em "zap", "uatsap", "watsap" ou outras atrocidades linguísticas.
  */
  function isWhatsappCommand(command: string) {
    const normalizedCommand = normalizeText(command);

    return (
      normalizedCommand.includes("whatsapp") ||
      normalizedCommand.includes("whats app") ||
      normalizedCommand.includes("watsap") ||
      normalizedCommand.includes("uatsap") ||
      normalizedCommand.includes("zap") ||
      normalizedCommand.includes("zapi") ||
      normalizedCommand.includes("mensagens do whatsapp") ||
      normalizedCommand.includes("mensagem do whatsapp") ||
      normalizedCommand.includes("verifique as mensagens") ||
      normalizedCommand.includes("verificar mensagens") ||
      normalizedCommand.includes("leia as mensagens") ||
      normalizedCommand.includes("ler mensagens")
    );
  }

  /*
    Processa o comando reconhecido.

    Aqui é onde o Jarvis decide o que fazer.
    Por enquanto, temos comandos básicos e o comando simulado do WhatsApp.
  */
  function processCommand(command: string) {
    const normalizedCommand = normalizeText(command);

    setAssistantState("processing");
    finishCommandMode();

    setTimeout(() => {
      /*
        Comando principal desta etapa:
        "Jarvis, verifique as mensagens do WhatsApp"
      */
      if (isWhatsappCommand(normalizedCommand)) {
        const summary = getSimulatedWhatsappSummary();
        speak(summary);
        return;
      }

      /*
        Comandos simples de saudação.
      */
      if (
        normalizedCommand.includes("bom dia") ||
        normalizedCommand.includes("boa tarde") ||
        normalizedCommand.includes("boa noite")
      ) {
        speak("Saudações, Mestre. Sistemas operacionais e sarcasmo em funcionamento.");
        return;
      }

      /*
        Pausa a escuta contínua.
        Depois de pausado, para reativar por voz não funciona,
        porque ele estará parado. Aí precisa clicar no córtex.
      */
      if (
        normalizedCommand.includes("pare de ouvir") ||
        normalizedCommand.includes("pausar escuta") ||
        normalizedCommand.includes("desligar escuta")
      ) {
        shouldKeepListeningRef.current = false;
        stopRecognitionInstance();
        speak("Escuta contínua pausada, Mestre.");
        return;
      }

      /*
        Comandos de teste.
      */
      if (
        normalizedCommand.includes("esta funcionando") ||
        normalizedCommand.includes("está funcionando") ||
        normalizedCommand.includes("voce esta ai") ||
        normalizedCommand.includes("você está aí") ||
        normalizedCommand.includes("esta na escuta") ||
        normalizedCommand.includes("está na escuta")
      ) {
        speak("Estou na escuta, Mestre.");
        return;
      }

      /*
        Identidade do assistente.
      */
      if (
        normalizedCommand.includes("quem e voce") ||
        normalizedCommand.includes("quem é você") ||
        normalizedCommand.includes("qual seu nome")
      ) {
        speak("Eu sou Jarvis, seu assistente pessoal.");
        return;
      }

      /*
        Resposta padrão para comandos ainda não configurados.
      */
      speak(
        `Comando recebido: ${command}. Ainda não tenho uma ação configurada para isso. A base está funcionando, mas milagres continuam fora do escopo técnico.`
      );
    }, 700);
  }

  /*
    Recebe o texto reconhecido pela voz e decide se:
    - é só a chamada "Ei, Jarvis"
    - é chamada + comando direto
    - é um comando depois da chamada
    - ou é algo que deve ser ignorado
  */
  function handleTranscript(transcript: string) {
    const hasWakeWord = containsWakeWord(transcript);
    const commandWithoutWakeWord = removeWakeWord(transcript);

    /*
      Caso 1:
      Usuário falou só "Ei, Jarvis"
    */
    if (hasWakeWord && commandWithoutWakeWord.length === 0) {
      activateWakeMode();
      return;
    }

    /*
      Caso 2:
      Usuário falou "Jarvis, verifique as mensagens do WhatsApp"
    */
    if (hasWakeWord && commandWithoutWakeWord.length > 0) {
      processCommand(commandWithoutWakeWord);
      return;
    }

    /*
      Caso 3:
      Jarvis já foi chamado antes e está aguardando comando.
    */
    if (!isAwakeRef.current) {
      return;
    }

    processCommand(transcript);
  }

  /*
    Inicia a escuta contínua.

    O Jarvis fica ouvindo o ambiente, mas só reage quando detecta:
    "Ei, Jarvis"
    ou uma variação aceita.
  */
  function startContinuousListening() {
    if (!shouldKeepListeningRef.current) return;
    if (recognitionRef.current) return;
    if (isSpeakingRef.current) return;

    const SpeechRecognitionAPI =
      window.SpeechRecognition || window.webkitSpeechRecognition;

    /*
      Se a WebView não suportar reconhecimento de voz,
      o app fica visualmente parado.
    */
    if (!SpeechRecognitionAPI) {
      setAssistantState("standby");
      return;
    }

    const recognition = new SpeechRecognitionAPI();

    recognition.lang = "pt-BR";
    recognition.continuous = true;
    recognition.interimResults = false;
    recognition.maxAlternatives = 1;

    recognition.onstart = () => {
      setAssistantState("listening");
    };

    recognition.onresult = (event: SpeechRecognitionEvent) => {
      const transcriptParts: string[] = [];

      for (let index = event.resultIndex; index < event.results.length; index++) {
        const result = event.results[index];
        const transcript = result[0]?.transcript;

        if (transcript) {
          transcriptParts.push(transcript);
        }
      }

      const transcript = transcriptParts.join(" ").trim();

      if (transcript.length > 0) {
        handleTranscript(transcript);
      }
    };

    recognition.onerror = (event: SpeechRecognitionErrorEvent) => {
      /*
        Erros comuns que podem acontecer quando ninguém fala.
        Ignoramos para manter a escuta viva.
      */
      if (event.error === "no-speech" || event.error === "aborted") {
        return;
      }

      /*
        Se o usuário negar microfone, paramos tudo.
      */
      if (event.error === "not-allowed" || event.error === "service-not-allowed") {
        shouldKeepListeningRef.current = false;
        setAssistantState("standby");
        return;
      }
    };

    recognition.onend = () => {
      recognitionRef.current = null;

      /*
        Muitos mecanismos encerram a escuta sozinhos.
        Aqui reiniciamos para simular escuta contínua.
      */
      if (shouldKeepListeningRef.current && !isSpeakingRef.current) {
        scheduleRestartListening(450);
      }
    };

    recognitionRef.current = recognition;

    try {
      recognition.start();
    } catch {
      /*
        Se tentar iniciar duas vezes rápido demais, pode dar erro.
        Então esperamos um pouco e tentamos novamente.
      */
      recognitionRef.current = null;
      scheduleRestartListening(700);
    }
  }

  /*
    Clique no córtex:
    - se estiver ouvindo, pausa
    - se estiver pausado, reativa

    Não aparece botão na tela, mas o córtex ainda é clicável.
  */
  function toggleListeningByCoreClick() {
    if (shouldKeepListeningRef.current) {
      shouldKeepListeningRef.current = false;
      clearRestartTimeout();
      clearCommandTimeout();
      stopRecognitionInstance();
      window.speechSynthesis?.cancel();
      isSpeakingRef.current = false;
      isAwakeRef.current = false;
      setIsAwake(false);
      setAssistantState("standby");
      return;
    }

    shouldKeepListeningRef.current = true;
    startContinuousListening();
    speak("Jarvis em funcionamento, Mestre.");
  }

  /*
    Ao abrir o app:
    - carrega vozes disponíveis
    - inicia escuta contínua
    - limpa tudo ao fechar
  */
  useEffect(() => {
    shouldKeepListeningRef.current = true;

    if (window.speechSynthesis) {
      window.speechSynthesis.onvoiceschanged = () => {
        window.speechSynthesis.getVoices();
      };

      window.speechSynthesis.getVoices();
    }

    const startupTimer = window.setTimeout(() => {
      startContinuousListening();
    }, 800);

    return () => {
      window.clearTimeout(startupTimer);
      clearRestartTimeout();
      clearCommandTimeout();
      shouldKeepListeningRef.current = false;
      stopRecognitionInstance();
      window.speechSynthesis?.cancel();
    };
  }, []);

  /*
    Interface final:
    apenas o córtex.

    Nada de texto, caixa, botão, painel ou firula administrativa.
    Só o núcleo reagindo por estado.
  */
  return (
    <main className={`jarvis-screen ${state} ${isAwake ? "awake" : ""}`}>
      <section className="cortex-field">
        <button
          className="jarvis-cortex"
          type="button"
          onClick={toggleListeningByCoreClick}
          aria-label="Alternar escuta do Jarvis"
        >
          <span className="cortex-shadow" />
          <span className="cortex-ring cortex-ring-outer" />
          <span className="cortex-ring cortex-ring-middle" />
          <span className="cortex-ring cortex-ring-inner" />
          <span className="cortex-core" />
          <span className="cortex-black-hole" />
        </button>
      </section>
    </main>
  );
}

export default App;